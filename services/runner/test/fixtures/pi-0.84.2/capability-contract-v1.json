{
  "schemaVersion": "pi-capability-contract-v1",
  "contractVersion": 1,
  "runtime": {
    "packageName": "@earendil-works/pi-coding-agent",
    "packageVersion": "0.84.2",
    "nodeEngine": ">=22.19.0",
    "binary": "pi",
    "mode": "rpc",
    "configDirectoryPolicy": "new-empty-per-session",
    "sessionPersistence": false,
    "projectResources": false,
    "offline": true,
    "telemetry": false,
    "versionChecks": false,
    "arguments": [
      "--mode",
      "rpc",
      "--no-session",
      "--offline",
      "--no-context-files",
      "--no-extensions",
      "--no-skills",
      "--no-prompt-templates",
      "--no-themes",
      "--no-approve"
    ],
    "environment": {
      "PI_CODING_AGENT_DIR": "runtime-config",
      "PI_OFFLINE": "1",
      "PI_SKIP_VERSION_CHECK": "1",
      "PI_TELEMETRY": "0"
    }
  },
  "framing": {
    "recordDelimiter": "LF",
    "acceptsCrlfInput": true,
    "unicodeLineSeparatorsAreContent": true,
    "finalLfRequired": true,
    "objectRecordsOnly": true,
    "inboundMaxBytes": 262144,
    "outboundMaxBytes": 4194304,
    "failureScope": "session",
    "recordSizeExcludesDelimiter": true
  },
  "rpc": {
    "commands": [
      {
        "type": "get_state",
        "responseCardinality": "exactly-one-correlated"
      },
      {
        "type": "set_model",
        "responseCardinality": "exactly-one-correlated"
      },
      {
        "type": "prompt",
        "responseCardinality": "exactly-one-correlated"
      },
      {
        "type": "abort",
        "responseCardinality": "exactly-one-correlated"
      },
      {
        "type": "get_session_stats",
        "responseCardinality": "exactly-one-correlated"
      }
    ],
    "normalTerminal": "agent_settled",
    "nonTerminals": [
      "agent_end"
    ],
    "abortAcknowledgementIsTerminal": false,
    "duplicateTerminalPolicy": "ignore-after-first",
    "abnormalTerminalClasses": [
      {
        "class": "protocol_error",
        "code": "PI_RPC_PROTOCOL_ERROR"
      },
      {
        "class": "process_exit",
        "code": "PI_RPC_PROCESS_EXIT"
      },
      {
        "class": "process_signal",
        "code": "PI_RPC_PROCESS_SIGNAL"
      },
      {
        "class": "stdin_error",
        "code": "PI_RPC_STDIN_ERROR"
      },
      {
        "class": "timeout",
        "code": "PI_RPC_TIMEOUT"
      },
      {
        "class": "cancelled",
        "code": "PI_RPC_CANCELLED"
      }
    ],
    "fatalInputClasses": [
      "malformed",
      "null",
      "array",
      "primitive",
      "oversized",
      "unterminated"
    ]
  },
  "usage": {
    "streaming": "cumulative-snapshot-never-sum",
    "finalMessage": "per-message-authoritative",
    "postSettlementSessionStats": "whole-session-aggregate",
    "continuedTurns": "subtract-pre-turn-session-baseline",
    "reasoning": "subset-of-output",
    "unavailable": "unknown-never-zero-filled",
    "precedence": [
      "post-settlement-session-stats-delta",
      "deduplicated-final-message",
      "unknown"
    ]
  },
  "authClasses": [
    {
      "id": "api_key",
      "documentationCandidate": true,
      "admissionEnabled": true,
      "rejectionCode": null
    },
    {
      "id": "setup_token",
      "documentationCandidate": false,
      "admissionEnabled": false,
      "rejectionCode": "PI_AUTH_SETUP_TOKEN_DISABLED"
    },
    {
      "id": "provider_oauth",
      "documentationCandidate": false,
      "admissionEnabled": false,
      "rejectionCode": "PI_AUTH_PROVIDER_OAUTH_DISABLED"
    },
    {
      "id": "subscription",
      "documentationCandidate": false,
      "admissionEnabled": false,
      "rejectionCode": "PI_AUTH_SUBSCRIPTION_DISABLED"
    }
  ],
