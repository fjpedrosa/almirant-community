  "persistedSurfaceAudit": [
    {
      "surface": "agent_jobs",
      "auditStatus": "documented",
      "locations": [
        "backend/packages/database/src/schema/agent-jobs.ts",
        "backend/packages/database/src/repositories/agents/agent-job-repository.ts",
        "services/runner/src/shared/job-helpers.ts"
      ],
      "defaults": {
        "coding_agent": "claude-code",
        "ai_provider": "anthropic",
        "model": "claude-opus-4-8"
      },
      "nullability": {
        "provider": "not-null-no-default",
        "coding_agent": "not-null",
        "ai_provider": "not-null",
        "model": "not-null",
        "config": "not-null"
      },
      "duplicateRepresentations": [
        "coding_agent and config.codingAgent",
        "model and config.model"
      ],
      "precedence": "Current runner precedence conflicts: config.codingAgent wins for coding agent, while top-level model wins for model.",
      "legacyValues": [
        "Rows predating dedicated runtime columns may rely on config values and column defaults."
      ],
      "currentConflict": "createJob resolves top-level fields without rewriting duplicate JSONB fields, so inconsistent persisted pairs are possible."
    },
    {
      "surface": "loops",
      "auditStatus": "documented",
      "locations": [
        "backend/packages/database/src/schema/loops.ts",
        "backend/api/src/domains/agents/routes/loops.routes.ts",
        "backend/api/src/mcp/tools/loops.tools.ts"
      ],
      "defaults": {
        "provider": "claude-code",
        "coding_agent": "claude-code",
        "ai_provider": "anthropic",
        "model": "none"
      },
      "nullability": {
        "provider": "not-null",
        "coding_agent": "not-null",
        "ai_provider": "not-null",
        "model": "nullable",
        "reasoning_level": "nullable"
      },
      "duplicateRepresentations": [],
      "precedence": "Loop columns are the persisted source and are projected into each iteration job at dispatch.",
      "legacyValues": [
        "codex-cli is not representable by the coding_agent enum used by loops."
      ],
      "currentConflict": "Loop REST and MCP validation omit Google despite ai_provider enum support, and provider is still derived as a coupled runtime lane."
    },
    {
      "surface": "scheduled_agent_configs",
      "auditStatus": "documented",
      "locations": [
        "backend/packages/database/src/schema/scheduled-agent-configs.ts",
        "backend/packages/database/src/repositories/agents/scheduled-agent-config-normalization.ts",
        "backend/packages/shared/src/agents/scheduled-runtime-precedence.ts"
      ],
      "defaults": {
        "coding_agent": "claude-code",
        "enabled": "false",
        "target_config": "empty-object"
      },
      "nullability": {
        "provider": "not-null",
        "coding_agent": "nullable-despite-default",
        "ai_provider": "nullable",
        "ai_model": "nullable",
        "reasoning_level": "nullable"
      },
      "duplicateRepresentations": [
        "Resolved runtime is copied into agent_jobs top-level fields and selected config metadata."
      ],
      "precedence": "Fieldwise execution precedence is rule, schedule, work item, project, connection, then defaults.",
      "legacyValues": [
        "codex-cli is accepted by the varchar column and normalized to codex on repository reads and writes."
      ],
      "currentConflict": "Fieldwise precedence can combine coding agent, AI provider, and model from different sources into a tuple never validated atomically."
    },
    {
      "surface": "work_items",
      "auditStatus": "documented",
      "locations": [
        "backend/packages/database/src/schema/work-items.ts",
        "backend/packages/shared/src/agents/scheduled-runtime-precedence.ts"
      ],
      "defaults": {
        "coding_agent": "none",
        "ai_model": "none"
      },
      "nullability": {
        "coding_agent": "nullable",
        "ai_model": "nullable",
        "ai_provider": "not-present",
        "provider": "not-present"
      },
      "duplicateRepresentations": [
        "Work-item fields may override scheduled, project, and connection runtime fields during dispatch."
      ],
      "precedence": "Work-item values are a fieldwise middle layer below schedule and above project defaults.",
      "legacyValues": [
        "Null means inherit; unknown future enum values cannot be stored before enum expansion."
      ],
      "currentConflict": "The surface persists only coding agent and model, so it cannot preserve a complete provider-bound runtime tuple."
    },
    {
      "surface": "system_settings.agent_routing",
      "auditStatus": "documented",
      "locations": [
        "backend/packages/database/src/schema/system-settings.ts",
        "backend/packages/database/src/repositories/agents/agent-job-repository.ts"
      ],
      "defaults": {
        "agent_routing": "empty-object",
        "job_fallback_coding_agent": "claude-code",
        "job_fallback_ai_provider": "anthropic",
        "job_fallback_model": "claude-opus-4-8"
      },
      "nullability": {
        "agent_routing": "not-null",
        "entry.codingAgent": "nullable",
        "entry.aiProvider": "nullable",
        "entry.model": "nullable",
        "entry.providerConnectionId": "nullable"
      },
      "duplicateRepresentations": [
        "Routing overrides are copied into agent_jobs columns while providerConnectionId is copied into config JSONB."
      ],
      "precedence": "Explicit createJob input wins, then internal-skill routing per field, then hardcoded defaults.",
      "legacyValues": [
        "aiProvider remains for rows created before connection-owned provider selection."
      ],
      "currentConflict": "The unversioned JSONB map permits partial and internally inconsistent runtime and connection combinations."
    },
    {
      "surface": "agent_native_events",
      "auditStatus": "documented",
      "locations": [
        "backend/packages/database/src/schema/agent-native-events.ts",
        "backend/packages/database/src/repositories/agents/native-event-repository.ts"
      ],
      "defaults": {
        "source_format": "sse",
        "received_at": "database-now"
      },
      "nullability": {
        "provider": "nullable",
        "coding_agent": "nullable",
        "runtime_session_id": "nullable",
        "payload": "not-null",
        "ai_provider": "not-present",
        "model": "not-present"
      },
      "duplicateRepresentations": [
        "payload may repeat provider, coding agent, model, usage, and terminal data without typed precedence."
      ],
      "precedence": "Typed columns should remain envelope provenance; payload is native evidence and must not silently override them.",
      "legacyValues": [
        "Historical source formats include sse, opencode-sse, and codex-shaped native event payloads."
      ],
      "currentConflict": "The table cannot distinguish requested, resolved, and observed AI provider/model and has no Pi source-format contract yet."
    }
  ],
